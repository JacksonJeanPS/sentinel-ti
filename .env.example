# Supabase (a chave publicável pode ser usada no navegador; nunca exponha a secret/service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Provedores opcionais. Sem eles, DNS, RDAP, NVD e TLS continuam disponíveis.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
ALIENVAULT_OTX_API_KEY=

# URL canônica usada em callbacks e metadados
NEXT_PUBLIC_SITE_URL=http://localhost:3000

